{
  "name": "alkemyst",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @alkemyst/desktop dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && pnpm --filter @alkemyst/site check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "sdk:generate": "node scripts/generate-sdk.mjs",
    "sdk:check": "node scripts/generate-sdk.mjs --check",
    "test:rust": "cargo test --workspace --locked",
    "coverage:rust": "pnpm --filter @alkemyst/desktop build && node scripts/coverage-rust.mjs",
    "security": "node scripts/security.mjs",
    "verify": "pnpm format:check && pnpm check:architecture && pnpm test:tooling && pnpm lint && pnpm typecheck && pnpm test:coverage && cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && pnpm test:rust && pnpm coverage:rust && pnpm sdk:check && pnpm api:lint",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "gate:probes": "node scripts/gate-zero-probes.mjs",
    "api:lint": "redocly lint src/sdk/schema/openapi.json",
    "native:build": "node scripts/native-build.mjs",
    "native:package": "node scripts/native-package.mjs",
    "test:site": "playwright test --config playwright.site.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "eslint-plugin-astro": "3.2.1",
    "prettier-plugin-astro": "1.1.1"
  }
}

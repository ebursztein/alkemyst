  "components": {
    "schemas": {
      "ArenaExport": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "ArenaIds": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        },
        "additionalProperties": false
      },
      "ArenaResolution": {
        "type": "object",
        "required": [
          "arena_id"
        ],
        "properties": {
          "arena_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "card": {
            "description": "The original printing metadata; null explicitly means unresolved."
          },
          "resolved_by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "BuildInfo": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "CardPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CardSummary": {
        "type": "object",
        "required": [
          "oracle_id",
          "id",
          "name",
          "type_line",
          "oracle_text",
          "color_identity",
          "arena_available"
        ],
        "properties": {
          "arena_available": {
            "type": "boolean"
          },
          "color_identity": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          },
          "image_uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "mana_cost": {
            "type": [
              "string",
              "null"
            ]
          },
          "mana_value": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "name": {
            "type": "string"
          },
          "oracle_id": {
            "type": "string"
          },
          "oracle_text": {
            "type": "string"
          },
          "type_line": {
            "type": "string"
          }
        }
      },
      "CatalogSource": {
        "type": "object",
        "required": [
          "url",
          "updated_at"
        ],
        "properties": {
          "updated_at": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "CatalogStatus": {
        "type": "object",
        "required": [
          "cards",
          "printings",
          "arena_ids"
        ],
        "properties": {
          "arena_ids": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cards": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "printings": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "snapshot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CatalogSource"
              }
            ]
          }
        }
      },
      "CreateDeck": {
        "type": "object",
        "required": [
          "name",
          "format",
          "cards"
        ],
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeckCard"
            }
          },
          "format": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateDeckCommand": {
        "type": "object",
        "required": [
          "idempotency_key",
          "input"
        ],
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/CreateDeck"
          }
        },
        "additionalProperties": false
      },
      "CreateNoteCommand": {
        "type": "object",
        "required": [
          "idempotency_key",
          "input"
        ],
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/NewNote"
          }
        },
        "additionalProperties": false
      },
      "CreateVersionCommand": {
        "type": "object",
        "required": [
          "idempotency_key",
          "input"
        ],
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/NewVersion"
          }
        },
        "additionalProperties": false
      },
      "DeckCard": {
        "type": "object",
        "required": [
          "reference",
          "quantity",
          "zone"
        ],
        "properties": {
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "reference": {
            "type": "string",
            "description": "oracle:<id>, scryfall:<printing-id>, or arena:<numeric-id>."
          },
          "zone": {
            "$ref": "#/components/schemas/Zone"
          }
        }
      },
      "DeckPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeckSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DeckSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "format",
          "latest_version",
          "version_count",
          "main_count"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "latest_version": {
            "type": "string"
          },
